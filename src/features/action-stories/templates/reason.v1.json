      "blockType": "statList",
      "binding": "proposal.inputs",
      "section": "provenance",
      "when": {
        "path": "proposal.inputs",
        "op": "exists"
      }
    },
    {
      "slotName": "agents",
      "blockType": "roster",
      "binding": "proposal.agents",
      "section": "provenance",
      "when": {
        "path": "proposal.agents",
        "op": "exists"
      }
    },
    {
      "slotName": "stage_status",
      "blockType": "text",
      "binding": "status_note",
      "section": "context",
      "when": {
        "path": "status_note",
        "op": "truthy"
      }
    }
