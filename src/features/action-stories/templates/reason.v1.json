{
  "template_id": "reason.v1",
  "stage": "reason",
  "sections": [
    {
      "id": "rationale",
      "title": null,
      "region": "main"
    },
    {
      "id": "governance",
      "title": "Policy",
      "region": "main"
    },
    {
      "id": "context",
      "title": "Context",
      "region": "rail"
    },
    {
      "id": "provenance",
      "title": "Basis",
      "region": "rail"
    }
  ],
  "blocks": [
    {
      "slotName": "narrative",
      "blockType": "text",
      "binding": "narrative",
      "section": "rationale",
      "role": "hero",
      "when": {
        "path": "narrative",
        "op": "truthy"
      }
    },
    {
      "slotName": "trigger",
      "blockType": "timeline",
      "binding": "proposal.trigger",
      "section": "rationale",
      "when": {
        "path": "proposal.trigger",
        "op": "exists"
      }
    },
    {
      "slotName": "policy",
      "blockType": "table",
      "binding": "proposal.policy",
      "section": "governance",
      "when": {
        "path": "proposal.policy",
        "op": "exists"
      }
    },
    {
      "slotName": "constraints",
      "blockType": "labelValueList",
      "binding": "proposal.constraints",
      "section": "governance",
      "when": {
        "path": "proposal.constraints",
        "op": "exists"
      }
    },
    {
      "slotName": "roles",
      "blockType": "table",
      "binding": "proposal.roles",
      "section": "governance",
      "when": {
        "path": "proposal.roles",
        "op": "exists"
      }
    },
    {
      "slotName": "decision_lens",
      "blockType": "text",
      "binding": "lens",
      "section": "context",
      "when": {
        "path": "lens",
        "op": "exists"
      }
