      {
        "title": "Same SKU in overlapping promos",
        "detail": "14 SKUs appear in both the DTC early-BF window (Nov 7–14) and Walmart Deal Days (Nov 12–18), overlapping for three days.",
        "fix": "Fix: shift the DTC window to Nov 3–10, or drop the 14 from one of the two.",
        "severity": "blocking"
      },
      {
        "title": "Marketplace parity violation",
        "detail": "Those same 14 SKUs would show 25% off on DTC and 15% off on Walmart in the same week. Walmart parity terms require our lowest advertised price.",
        "fix": "Fix: match depth at 15%, or exclude the shared SKUs from the DTC event.",
        "severity": "blocking"
      },
      {
        "title": "Deal-stacking risk",
        "detail": "6 BFCM SKUs carry an active Amazon coupon that stacks on top of the deal price, taking the effective discount to 34% — past both the depth ceiling and the CM floor.",
        "fix": "Fix: suppress the coupons for the window, or reduce deal depth on those 6.",
        "severity": "blocking"
      },
      {
        "title": "Full-price protection window",
        "detail": "11 gift-guide SKUs were promoted 8 days earlier in BFCM, inside the 14-day minimum gap set in Reason.",
        "fix": "Fix: start the gift guide Dec 12, or swap those 11 for full-price alternates.",
        "severity": "warning"
      },
      {
        "title": "Unit commitment above cover",
        "detail": "Prime Fall requires 500 units per SKU. Three SKUs have 380–460 units of cover before the event, so the commitment cannot be met without an expedited inbound.",
        "fix": "Fix: drop the 3 SKUs, or pull the inbound forward — Planner has 11 days.",
        "severity": "warning"
      }
